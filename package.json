    "@capacitor/ios": "^8.6.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@huggingface/transformers": "^4.3.2",
    "@tailwindcss/vite": "^4.3.5",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
